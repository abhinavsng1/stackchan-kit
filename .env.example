# Neon Postgres connection string. Server-side only.
# Provision with: vercel integration add neon
# Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Mixpanel project token. Publishable by design — identifies the project to the
# browser. Not a secret. Set the real one with: vercel env add NEXT_PUBLIC_MIXPANEL_TOKEN
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Meta Pixel id. Publishable — it names the pixel to the browser, not a secret.
NEXT_PUBLIC_META_PIXEL_ID=

# Local browser tests only: use the in-memory Pixel queue without vendor SDKs.
# Leave unset for normal development and production. Preview hosts never track.
NEXT_PUBLIC_ANALYTICS_TEST_MODE=

# Razorpay. All three are server-side only — none carries a NEXT_PUBLIC_
# prefix, so none is baked into the browser bundle.
#
# KEY_ID is publishable in the sense that Razorpay's checkout script needs it
# in the browser, but it is handed out by /api/create-order in response to a
# valid payment token rather than published to every visitor.
#
# KEY_SECRET signs orders and verifies payment signatures.
# WEBHOOK_SECRET is a different value again: you choose it when creating the
# webhook in the Razorpay dashboard, and it signs incoming webhook bodies.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
